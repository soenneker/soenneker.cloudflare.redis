{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "soenneker-cloudflare-redis",
    "main": "worker/index.js",
    "compatibility_date": "2026-11-19",
    "workers_dev": true,
    "preview_urls": false,
    "triggers": { "crons": ["*/5 * * * *"] },
    "containers": [{
        "class_name": "RedisHost",
        "scheduling_policy": "durable_object",
        "images": { "redis": { "dockerfile": "./container/Dockerfile" } }
    }],
    "durable_objects": { "bindings": [{ "name": "REDIS_HOST", "class_name": "RedisHost" }] },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RedisHost"] }]
}
